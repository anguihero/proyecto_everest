{
  "name": "everest-experience",
  "version": "0.1.0",
  "type": "module",
  "description": "Everest Experience — plataforma B2B de diagnóstico de liderazgo",
  "scripts": {
    "start": "npx serve src/frontend -p 59871 --no-clipboard",
